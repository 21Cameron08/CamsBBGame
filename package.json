{
  "name": "courtside-dynasty",
  "private": true,
  "version": "0.1.0",
  "description": "Courtside Dynasty \u2014 a modern college basketball coaching dynasty sim (NIL, transfer portal, recruiting, media, March Madness).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim:test": "tsx scripts/simTest.ts",
    "season:test": "tsx scripts/seasonTest.ts",
    "build:api": "esbuild server/entry.ts --bundle --platform=node --format=esm --target=node20 --external:@vercel/blob --outfile=api/league.js --log-level=warning"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "framer-motion": "11.18.2",
    "idb-keyval": "6.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
